{
  "info": {
    "_postman_id": "0b8e3a52-71c4-4d2e-9f6a-3c5d8e2b7a41",
    "name": "Lab3 - API JPA",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "categoryId", "value": "", "type": "string" },
    { "key": "productId", "value": "", "type": "string" },
    { "key": "productId2", "value": "", "type": "string" },
    { "key": "orderId", "value": "", "type": "string" },
    { "key": "deletedProductId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Créer une catégorie",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Statut 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"categoryId\", pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Informatique\"\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{baseUrl}}/api/categories", "host": ["{{baseUrl}}"], "path": ["api", "categories"] }
      }
    },
    {
      "name": "2. Créer un produit",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Statut 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Le produit est lié à la catégorie\", () => pm.expect(pm.response.json().categoryId).to.eql(Number(pm.collectionVariables.get(\"categoryId\"))));",
              "pm.collectionVariables.set(\"productId\", pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Clavier {{$timestamp}}\",\n  \"price\": 49.99,\n  \"categoryId\": {{categoryId}}\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{baseUrl}}/api/products", "host": ["{{baseUrl}}"], "path": ["api", "products"] }
      }
    },
    {
      "name": "3. Créer un deuxième produit",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Statut 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"productId2\", pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Souris {{$timestamp}}\",\n  \"price\": 19.90,\n  \"categoryId\": {{categoryId}}\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{baseUrl}}/api/products", "host": ["{{baseUrl}}"], "path": ["api", "products"] }
      }
    },
    {
      "name": "4. Lire un produit",
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test(\"Statut 200\", () => pm.response.to.have.status(200));"] } }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/products/{{productId}}", "host": ["{{baseUrl}}"], "path": ["api", "products", "{{productId}}"] }
      }
    },
    {
      "name": "5. Liste paginée des produits",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"La page contient au plus 5 produits\", () => pm.expect(pm.response.json().content.length).to.be.at.most(5));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products?page=0&size=5&sort=id",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products"],
          "query": [
            { "key": "page", "value": "0" },
            { "key": "size", "value": "5" },
            { "key": "sort", "value": "id" }
          ]
        }
      }
    },
    {
      "name": "6. Produits d'une catégorie",
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test(\"Statut 200\", () => pm.response.to.have.status(200));"] } }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/categories/{{categoryId}}/products", "host": ["{{baseUrl}}"], "path": ["api", "categories", "{{categoryId}}", "products"] }
      }
    },
    {
      "name": "7. Créer une commande avec 2 articles",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Statut 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"La commande contient 2 articles\", () => pm.expect(pm.response.json().items.length).to.eql(2));",
              "pm.collectionVariables.set(\"orderId\", pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"items\": [\n    { \"productId\": {{productId}}, \"quantity\": 2 },\n    { \"productId\": {{productId2}}, \"quantity\": 1 }\n  ]\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{baseUrl}}/api/orders", "host": ["{{baseUrl}}"], "path": ["api", "orders"] }
      }
    },
    {
      "name": "8. Lire la commande",
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test(\"Statut 200\", () => pm.response.to.have.status(200));"] } }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/orders/{{orderId}}", "host": ["{{baseUrl}}"], "path": ["api", "orders", "{{orderId}}"] }
      }
    },
    {
      "name": "9. Créer un produit à supprimer",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Statut 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"deletedProductId\", pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Webcam {{$timestamp}}\",\n  \"price\": 39.90,\n  \"categoryId\": {{categoryId}}\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{baseUrl}}/api/products", "host": ["{{baseUrl}}"], "path": ["api", "products"] }
      }
    },
    {
      "name": "10. Supprimer le produit",
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test(\"Statut 204\", () => pm.response.to.have.status(204));"] } }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/products/{{deletedProductId}}", "host": ["{{baseUrl}}"], "path": ["api", "products", "{{deletedProductId}}"] }
      }
    },
    {
      "name": "11. Lire le produit supprimé",
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test(\"Statut 404\", () => pm.response.to.have.status(404));"] } }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/products/{{deletedProductId}}", "host": ["{{baseUrl}}"], "path": ["api", "products", "{{deletedProductId}}"] }
      }
    },
    {
      "name": "12. Créer un produit invalide",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Statut 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Les erreurs portent sur name et price\", () => pm.expect(pm.response.json()).to.have.keys(\"name\", \"price\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"\",\n  \"price\": -5,\n  \"categoryId\": {{categoryId}}\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{baseUrl}}/api/products", "host": ["{{baseUrl}}"], "path": ["api", "products"] }
      }
    }
  ]
}
